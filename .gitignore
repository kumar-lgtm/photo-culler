# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate

# Build artifacts (regenerate with ./scripts/package-dmg.sh)
build/
*.app
*.dmg

# ...except the shipped installer, which IS tracked so anyone with the repo can install
# without a toolchain. Note this adds ~3 MB to git history per released build.
!dist/*.dmg

# Logs
*.log

# Dead scratch files: hardcoded absolute paths to local/client folders.
# Delete these when convenient — they are not part of the build.
/test_scan.swift
/test_scanner.swift

# Local agent tooling, not part of the app.
# .agents/ vendors twostraws/SwiftUI-Agent-Skill (MIT) without its LICENSE file;
# re-add it upstream-complete if you ever want it tracked here.
.agents/
.vscode/
